# ─── Vol à suivre ──────────────────────────────────
FLIGHT_NUMBER=TS691
ALERT_PHONE=+14182627032
CHECK_INTERVAL_HOURS=2

# ─── API de suivi de vol ───────────────────────────
# Gratuit sur https://aviationstack.com (500 req/mois)
AVIATION_API_KEY=your_aviationstack_key_here

# ─── Twilio SMS ────────────────────────────────────
# Créer un compte sur https://twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── WhatsApp (optionnel) ──────────────────────────
# Activer le Twilio WhatsApp Sandbox avant d'utiliser
WHATSAPP_ENABLED=false

# ─── Serveur ───────────────────────────────────────
PORT=3000
DEMO_MODE=false
